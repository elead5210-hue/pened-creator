# Copy this file to ".env" (or ".env.local") and adjust as needed. Vite
# only exposes env vars prefixed with VITE_ to client code.
#
# IMPORTANT: VITE_* values are read at build/dev-server start and baked
# into the client bundle. They can't be changed at runtime, so after
# editing this file restart `vite`/`bun run dev`, and for a deployed app
# rebuild and redeploy it (in Docker/Fly, pass VITE_API_URL as a build
# argument, not a runtime environment variable).

# Base URL of the penedv1-server API this app talks to (see the API
# project's README.md). No trailing slash, e.g.:
#   Local API:     VITE_API_URL=http://localhost:4000
#   Deployed API:  VITE_API_URL=https://pened-server.fly.dev
# Required — the app has no built-in fallback and every data-access call
# (auth, curriculum tree, questions, lesson breakdowns, lesson records,
# Phase 3 generation) will fail without it. Production builds should use
# an https:// URL.
#
# Authentication is by session cookie (sent with `credentials: "include"`),
# not an API key. When the API is on a different origin than this app, the
# API's CORS_ORIGIN setting must include this app's exact origin (e.g.
# http://localhost:5174 in development), or the browser will block login.
VITE_API_URL=http://localhost:4000

# Base URL of the pened-tools app, used both to embed interactive tool
# content (multiple-choice cards, etc.) inside lesson content views, and
# to build the "Open in pened-tools" link for a lesson's saved slideshow
# (see the "Generate Slideshow Data" step). The slideshow link is
# <base URL>/tool/slideshow/<encoded lesson id>, where the lesson id is
# "<project_id>:<lesson_node_id>" with the colon sent as %3A. It carries
# only the lesson id, never the deck: pened-tools' own server fetches the
# deck from pened-server on each request, so the deck must already be
# saved on the lesson. (Older links that encoded the whole deck in the
# URL still open in pened-tools, but this app no longer creates them.)
# No trailing slash, e.g.:
#   Local renderer:   VITE_TOOL_RENDERER_BASE_URL=http://192.168.1.66:4500
#   Deployed renderer: VITE_TOOL_RENDERER_BASE_URL=https://pened-tools.fly.dev
# Optional — when unset, tool-registry content blocks and the slideshow
# link both show a clear inline message instead. Like VITE_API_URL, this
# value is baked into the client bundle at build time, so changing it
# means restarting the dev server or rebuilding and redeploying.
#
# Only public URLs belong in VITE_* variables: anything here ships to
# every browser. Never put an API key or other secret in one. In
# particular, pened-tools' own PENED_API_KEY / PENED_SERVER_URL are Fly
# secrets on the pened-tools app and must not be used or copied here.
VITE_TOOL_RENDERER_BASE_URL=http://192.168.1.66:4500

# Tool suggestions (see docs/api-handoff/tool-suggestions.md).
#
# The suggestions endpoints live on the same API as everything else, so
# there is no separate URL variable: the client calls
# <VITE_API_URL>/api/tool-suggestions with the session cookie. Only the
# mock toggle below is configurable.
#
# Set to "true" to use the built-in mock adapter, which returns the stub
# responses from the hand-off doc (with ~400ms simulated latency) instead
# of calling the API. Use it until the API Agent has delivered the
# endpoints. Leave unset or "false" to call the real API. Like the other
# VITE_* values, this is baked in at build time, so restart the dev server
# or rebuild after changing it. Never enable it in production builds.
#
# Mock trigger texts: submitting exactly "simulate-error" returns a 500,
# and "simulate-rate-limit" returns a 429.
VITE_USE_MOCK_TOOL_SUGGESTIONS=false